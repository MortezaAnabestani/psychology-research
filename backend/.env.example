# ==============================================
# DATABASE
# ==============================================
MONGODB_URI=mongodb://localhost:27017/psychology-research
# برای MongoDB Atlas:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/psychology-research

# ==============================================
# SERVER
# ==============================================
PORT=5000
NODE_ENV=production

# ==============================================
# JWT SECRET
# ==============================================
JWT_SECRET=your-very-secure-random-jwt-secret-key-here
# برای تولید یک کلید امن می‌توانید از این دستور استفاده کنید:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ==============================================
# CLIENT URL (آدرس فرانت‌اند شما)
# ==============================================
CLIENT_URL=https://yourdomain.com
# در محیط لوکال: http://localhost:3000

# ==============================================
# EMAIL SETTINGS (تنظیمات ایمیل)
# ==============================================
# آدرس ایمیل فرستنده
EMAIL_USER=mail@mashaayekhi.ir

# رمز عبور ایمیل
EMAIL_PASSWORD=your-email-password-here

# سرور SMTP (برای هاست‌های ایرانی معمولاً از mail.domainname.com استفاده می‌شود)
EMAIL_HOST=mail.mashaayekhi.ir
# برای Gmail: smtp.gmail.com
# برای Outlook: smtp-mail.outlook.com
# برای Yahoo: smtp.mail.yahoo.com
# برای Brevo (SendInBlue): smtp-relay.brevo.com
# برای Mailgun: smtp.mailgun.org
# برای SendGrid: smtp.sendgrid.net

# پورت SMTP
EMAIL_PORT=587
# پورت 587 برای TLS/STARTTLS
# پورت 465 برای SSL
# پورت 25 برای ارتباط بدون رمزنگاری (توصیه نمی‌شود)

# نام نمایشی فرستنده
EMAIL_FROM_NAME=پژوهش روانشناسی

# ==============================================
# GMAIL RELAY (اختیاری - برای ارسال به Gmail)
# ==============================================
# اگر می‌خواهید فقط برای Gmail از سرویس دیگری استفاده کنید (مثل Brevo)
# GMAIL_RELAY_HOST=smtp-relay.brevo.com
# GMAIL_RELAY_PORT=587
# GMAIL_RELAY_USER=mail@mashaayekhi.ir
# GMAIL_RELAY_PASSWORD=your-brevo-smtp-key

# ==============================================
# SMS SETTINGS - KAVENEGAR (تنظیمات پیامک)
# ==============================================
# کلید API کاوه‌نگار (از پنل کاوه‌نگار دریافت کنید)
KAVENEGAR_API_KEY=your-kavenegar-api-key-here
# برای دریافت API Key:
# 1. وارد پنل کاوه‌نگار شوید: https://panel.kavenegar.com
# 2. از منوی سمت راست روی "تنظیمات" کلیک کنید
# 3. در قسمت "API Key" کلید خود را کپی کنید

# شماره فرستنده (خط اختصاصی)
KAVENEGAR_SENDER=10008663
# می‌توانید از شماره‌های زیر استفاده کنید:
# - خط اختصاصی خودتان (اگر دارید)
# - شماره عمومی کاوه‌نگار: 10008663

# توضیحات سرویس‌های کاوه‌نگار:
# 1. سرویس پایه: برای ارسال پیامک ساده
# 2. سرویس لوکاپ (Lookup): برای ارسال پیامک‌های الگویی (Template)
# 3. سرویس OTP: برای ارسال کد تایید
#
# برای این پروژه نیاز به سرویس پایه دارید

# ==============================================
# WEB PUSH NOTIFICATIONS (نوتیفیکیشن وب)
# ==============================================
# ایمیل VAPID (می‌تواند همان ایمیل اصلی شما باشد)
VAPID_EMAIL=mail@mashaayekhi.ir

# کلیدهای VAPID (برای تولید از دستور زیر استفاده کنید)
# npm install -g web-push
# web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here

# ==============================================
# ADMIN USER (حساب کاربری ادمین اولیه)
# ==============================================
ADMIN_EMAIL=admin@mashaayekhi.ir
ADMIN_PASSWORD=admin123456
ADMIN_NAME=مدیر سیستم
